[Unit]
Description=Quest Log (personal-os mission board)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/quest-log.env
ExecStart=__NODE__ __APP_DIR__/server/index.js
Restart=on-failure
RestartSec=5
# git needs HOME for ~/.ssh and ~/.gitconfig
Environment=HOME=__HOME__
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
