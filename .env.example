# Quest Log configuration. The installer copies this to /etc/quest-log.env (systemd reads it).

# Where the server listens. Keep 0.0.0.0 to reach it over Tailscale / LAN.
HOST=0.0.0.0
PORT=8787

# Your clone of github.com/Kevin75311/personal-os on the Pi.
REPO_DIR=/home/kevin/personal-os
# Quest data lives in REPO_DIR/quest/ (missions.json, player.json, events.json, inbox.json, QUEST-LOG.md)
DATA_SUBDIR=quest
# Gemini's calendar export, relative to REPO_DIR (read-only for Quest Log)
CALENDAR_FILE=calendar.md
TZ_NAME=America/Los_Angeles

# --- git sync ---
GIT_ENABLED=true
# Start with false: the first run seeds quest/ from the bundled seed and commits locally.
# Review quest/QUEST-LOG.md, then set true and restart: sudo systemctl restart quest-log
GIT_PUSH=false
GIT_REMOTE=origin
GIT_BRANCH=main
# Batch edits for this long before committing/pushing (ms)
COMMIT_DEBOUNCE_MS=20000
# Pull remote changes (other agents, calendar.md updates) this often (ms). 0 = off.
PULL_INTERVAL_MS=300000
GIT_AUTHOR_NAME=Quest Log (rpi)
GIT_AUTHOR_EMAIL=quest-log@rpi.local

# Optional: require a passcode in the browser (recommended if you expose beyond Tailscale)
QUEST_PASSCODE=
